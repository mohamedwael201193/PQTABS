{
  "name": "pqtabs-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "lint": "biome check src test"
  },
  "dependencies": {
    "@hono/node-server": "1.19.5",
    "hono": "4.10.2",
    "viem": "2.38.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "24.7.2",
    "typescript": "5.9.3"
  }
}
