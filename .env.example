# PQTABS environment template.
# Copy to .env and fill locally. Never commit .env. Never put the PQ seed or the deployer key on Render.

# --- Public chain config (REQUIRED NOW) ---
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
ARC_EXPLORER_URL=https://explorer.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000
PQ_PRECOMPILE_ADDRESS=0x1800000000000000000000000000000000000004
BARKEEP_FACTORY_ADDRESS=0xccebc58dd1f5937b36d5f9f89f0754424f4d443c
BARKEEP_TAB_IMPLEMENTATION=0x89B63f2E43dea9014750925C01996D34856B01D2

# --- Deployer: local machine only (REQUIRED NOW, SECRET) ---
# Used to deploy PQRoot and to send it USDC. Never upload to Render, Vercel, or GitHub.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# --- Relayer: generated in Phase 1, not a copy of the deployer (REQUIRED LATER, SECRET) ---
# Render may hold this key. It can only submit transactions. Fund it with a small USDC gas float.
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=

# --- Demo agent: generated in Phase 1, disposable (REQUIRED LATER, SECRET) ---
# Stays on the operator machine. Do not put it on Render. Losing it loses at most one tab.
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=

# --- Filled after Phase 4 deploy (REQUIRED LATER, PUBLIC) ---
PQROOT_ADDRESS=

# --- Offline PQ signer (REQUIRED LATER) ---
# Path to the key file. The file lives in pq-keys/ and is gitignored.
# Do not put the SLH-DSA seed in this env file or on Render.
PQ_SIGNER_KEY_PATH=pq-keys/root.json

# --- x402 (OPTIONAL) ---
# Direct transferWithAuthorization is the required payment proof.
# The facilitator is only for the optional HTTP demo.
X402_FACILITATOR_BASE=https://api.circle.com
X402_NETWORK=eip155:5042
CIRCLE_API_KEY=

# --- Hosting tokens: local deploy tooling only (OPTIONAL, SECRET) ---
# Do not place these on the Render service itself.
RENDER_API_KEY=
VERCEL_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=https://github.com/mohamedwael201193/PQTABS

# --- Filled after Phase 14 (OPTIONAL, PUBLIC) ---
BACKEND_URL=
